#!/usr/bin/env bash
set -e

cd "$(dirname "$0")/.."

if [ ! -f .env.desktop ]; then
    echo "Error: .env.desktop not found."
    exit 1
fi

# Load desktop-mode environment variables
set -a
source .env.desktop
set +a

# Load the desktop PHP configuration (extensions for the bundled binary)
export PHPRC="$PWD/desktop"

# Locate the FrankenPHP binary: desktop/bin first, then PATH.
if [ -x "desktop/bin/frankenphp" ]; then
    FRANKENPHP="desktop/bin/frankenphp"
elif [ -x "desktop/bin/frankenphp.exe" ]; then
    FRANKENPHP="desktop/bin/frankenphp.exe"
elif command -v frankenphp >/dev/null 2>&1; then
    FRANKENPHP="frankenphp"
else
    echo "Error: FrankenPHP binary not found."
    echo "Download it from https://frankenphp.dev and place it in desktop/bin/ (or add it to your PATH)."
    exit 1
fi

# Install Composer dependencies if needed
if [ ! -d "vendor" ] || [ ! -f "vendor/autoload.php" ]; then
    echo "Installing Composer dependencies..."
    composer install --no-interaction --prefer-dist --optimize-autoloader
fi

# Clear the desktop cache: a stale cache (built with APP_ENV=dev) could
# point the app to the wrong database.
if [ -d "var/cache/desktop" ]; then
    echo "Clearing desktop cache..."
    rm -rf var/cache/desktop
fi

# Prepare the local SQLite database
# var/app.db is created automatically on first connection.
mkdir -p var
echo "Updating SQLite schema (var/app.db)..."
"$FRANKENPHP" php-cli bin/console doctrine:schema:update --force --env=desktop --no-interaction

# Start FrankenPHP in worker mode (see desktop/Caddyfile).
echo "Starting FrankenPHP on http://localhost:8765"
echo "APP_ENV = $APP_ENV"
echo "DATABASE_URL = $DATABASE_URL"
# exec: bash is replaced by FrankenPHP, so stopping the desktop app really
# kills the server (no orphaned process).
exec "$FRANKENPHP" run --config "$PWD/desktop/Caddyfile"
