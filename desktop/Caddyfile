# FrankenPHP config for the desktop app (worker mode).
# Started by desktop/start / desktop/start.ps1 from the project root.
{
	auto_https off

	frankenphp {
		worker {
			file ./public/index.php
			# APP_ENV=desktop makes Dotenv load .env + .env.desktop
			# (SQLite DATABASE_URL, disabled mailer, sync messenger).
			env APP_ENV desktop
			env APP_DEBUG 0
		}
	}
}

http://localhost:8765 {
	root ./public/
	encode zstd br gzip
	php_server
}
