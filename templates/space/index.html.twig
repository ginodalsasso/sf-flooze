{% extends 'layout/app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'space/_styles.html.twig' %}
{% endblock %}

{% block title %}Mes espaces — Flooze{% endblock %}

{% block content %}
{% set _has_personal = false %}
{% set _has_pro = false %}
{% for s in spaces %}
    {% if s.type.value == 'personal' %}{% set _has_personal = true %}{% endif %}
    {% if s.type.value == 'professional' %}{% set _has_pro = true %}{% endif %}
{% endfor %}

<twig:PageHeader
    title="Mes espaces"
    subtitle="Gérez vos espaces personnel et professionnel"
    :ctaLabel="not (_has_personal and _has_pro) ? 'Créer un espace' : null"
    :ctaHref="not (_has_personal and _has_pro) ? path('app_space_new') : null"
/>

<div class="page-content">

    <twig:Flash />

    {% if spaces|length > 0 %}
    <div class="spaces-list-full">
        {% for space in spaces %}
        <div class="space-full-card">
            <twig:SpaceTypeIcon type="{{ space.type.value }}" size="lg" />
            <div class="space-full-body">
                <div class="space-full-name">{{ space.name }}</div>
                <div class="space-full-meta">
                    <span class="space-dot space-dot--{{ space.type.value }} space-dot--sm"></span>
                    {{ space.type.value == 'professional' ? 'Professionnel' : 'Personnel' }}
                    &middot; créé le {{ space.createdAt|date_short }}
                </div>
            </div>
            <div class="space-full-actions">
                <twig:Button as="a" href="{{ path('app_space_edit', {'id': space.id}) }}"
                             icon="pencil" label="Modifier" variant="secondary" />
                {% include 'space/forms/_delete.html.twig' with {space: space} %}
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="panel-card panel-card--constrained">
        <div class="panel-empty panel-empty--padded">
            <div class="panel-empty-icon"><i data-lucide="layers"></i></div>
            <p class="panel-empty-text">Aucun espace créé</p>
            <p class="panel-empty-hint">Un espace personnel et un espace professionnel te permettent de séparer tes finances</p>
        </div>
        <div class="panel-cta">
            <twig:Button as="a" href="{{ path('app_space_new') }}" icon="plus" label="Créer mon premier espace" />
        </div>
    </div>
    {% endif %}

    {% if archived|length > 0 %}
    <section class="spaces-archived">
        <h2 class="spaces-archived-title">Espaces archivés</h2>
        <p class="spaces-archived-hint">
            Leurs données sont conservées. Un espace se restaure jusqu'à la date indiquée.
        </p>

        <div class="spaces-list-full">
            {% for item in archived %}
            <div class="space-full-card space-full-card--archived">
                <twig:SpaceTypeIcon type="{{ item.space.type.value }}" size="lg" />
                <div class="space-full-body">
                    <div class="space-full-name">
                        {{ item.space.name }}
                        <twig:Badge label="Archivé" variant="inactive" />
                    </div>
                    <div class="space-full-meta">
                        <span class="space-dot space-dot--{{ item.space.type.value }} space-dot--sm"></span>
                        {{ item.space.type.value == 'professional' ? 'Professionnel' : 'Personnel' }}
                        &middot;
                        {% if item.isRestorable %}
                            restaurable jusqu'au {{ item.restorableUntil|date_short }}
                        {% else %}
                            fenêtre de récupération close le {{ item.restorableUntil|date_short }}
                        {% endif %}
                    </div>
                </div>
                <div class="space-full-actions">
                    {% if item.isRestorable and not item.isTypeTaken %}
                        {% include 'space/forms/_restore.html.twig' with {space: item.space} %}
                    {% elseif item.isRestorable %}
                        <span class="space-full-note">
                            Un espace {{ item.space.type.value == 'professional' ? 'professionnel' : 'personnel' }} actif occupe déjà ce type
                        </span>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

</div>
{% endblock %}
