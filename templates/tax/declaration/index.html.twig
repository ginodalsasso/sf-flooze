{% extends 'layout/app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'tax/declaration/_styles.html.twig' %}
{% endblock %}

{% block title %}Déclaration {{ summary.year }} — Flooze{% endblock %}

{% block content %}
<twig:PageHeader
    title="Déclaration {{ summary.year }}"
    subtitle="Catégorie fiscale par catégorie fiscale, comme la loi les cloisonne"
/>

<div class="page-content">
    <div class="dec-stack">

        {% include 'tax/_year_switcher.html.twig' with {
            routeName: 'app_declaration_index',
            currentYear: summary.year,
            availableYears: summary.availableYears,
        } %}

        {% include 'tax/_summary.html.twig' with {summary: summary, loanCharges: loanCharges} %}
    </div>
</div>
{% endblock %}
