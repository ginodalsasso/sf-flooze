{% extends 'layout/app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'real_estate/_styles.html.twig' %}
{% endblock %}

{% block title %}Nouveau locataire — Flooze{% endblock %}

{% block content %}
<twig:PageHeader title="Nouveau locataire" subtitle="Coordonnées et solvabilité" />

<div class="page-content">
    <div class="form-page">
        <twig:Flash levels="{{ ['error'] }}" />
        {% include 'real_estate/tenant/forms/_form.html.twig' with {submit_label: 'Créer le locataire'} %}
    </div>
</div>
{% endblock %}
