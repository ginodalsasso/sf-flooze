{% extends 'layout/app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'real_estate/_styles.html.twig' %}
{% endblock %}

{% block title %}Mes locataires — Flooze{% endblock %}

{% block content %}
<twig:PageHeader
    title="Mes locataires"
    subtitle="Coordonnées, revenus et garants"
    ctaLabel="Nouveau locataire"
    ctaHref="{{ path('app_tenant_new') }}"
/>

<div class="page-content">
    <twig:Flash />

    {% if tenants|length > 0 %}
        <div class="re-grid">
            {% for tenant in tenants %}
                {% set currency = tenant.space.currency %}
                <div class="re-card">
                    <div class="re-card-header">
                        <div class="re-card-icon">
                            <i data-lucide="user"></i>
                        </div>
                        {% if tenant.guarantorName %}
                            <twig:Badge label="Avec garant" variant="info" />
                        {% endif %}
                    </div>

                    <div>
                        <p class="re-card-name">{{ tenant.fullName }}</p>
                        <p class="re-card-sub">{{ tenant.email }}{% if tenant.phone %} · {{ tenant.phone }}{% endif %}</p>
                    </div>

                    <div class="re-facts">
                        <div class="re-fact">
                            <span class="re-fact-label">Revenu mensuel</span>
                            <span class="re-fact-value re-fact-value--mono">{{ tenant.monthlyIncome|money(currency) }}</span>
                        </div>
                        {% if tenant.guarantorName %}
                            <div class="re-fact">
                                <span class="re-fact-label">Garant</span>
                                <span class="re-fact-value">{{ tenant.guarantorName }}</span>
                            </div>
                            {% if tenant.guarantorIncome %}
                                <div class="re-fact">
                                    <span class="re-fact-label">Revenu du garant</span>
                                    <span class="re-fact-value re-fact-value--mono">{{ tenant.guarantorIncome|money(currency) }}</span>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>

                    <div class="re-card-footer">
                        <twig:Button
                            as="a"
                            href="{{ path('app_tenant_edit', {id: tenant.id}) }}"
                            icon="pencil"
                            label="Modifier"
                            variant="secondary"
                        />
                        {% include 'real_estate/tenant/forms/_delete.html.twig' with {tenant: tenant} %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <twig:EmptyState
            icon="users"
            text="Aucun locataire"
            hint="Enregistre un locataire avant de créer son bail."
            ctaLabel="Créer un locataire"
            ctaHref="{{ path('app_tenant_new') }}"
        />
    {% endif %}
</div>
{% endblock %}
