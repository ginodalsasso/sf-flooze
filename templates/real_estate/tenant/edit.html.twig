{% extends 'layout/app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'real_estate/_styles.html.twig' %}
{% endblock %}

{% block title %}Modifier « {{ tenant.fullName }} » — Flooze{% endblock %}

{% block content %}
<twig:PageHeader title="Modifier le locataire" subtitle="{{ tenant.fullName }}" />

<div class="page-content">
    <div class="form-page">
        <twig:Flash levels="{{ ['error'] }}" />
        {% include 'real_estate/tenant/forms/_form.html.twig' with {submit_label: 'Enregistrer'} %}
    </div>
</div>
{% endblock %}
