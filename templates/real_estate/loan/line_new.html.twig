{% extends 'layout/app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'real_estate/_styles.html.twig' %}
{% endblock %}

{% block title %}Nouvelle ligne de prêt — Flooze{% endblock %}

{% block content %}
<twig:PageHeader
    title="Nouvelle ligne de prêt"
    subtitle="{{ loan.bankName }} · {{ loan.property.name }}"
/>

<div class="page-content">
    <div class="form-page">
        <twig:Flash levels="{{ ['error'] }}" />

        <twig:Notice variant="info" icon="info" title="Une ligne = un capital, un taux, une durée">
            <p class="notice-text">
                Un dossier de prêt en compte souvent plusieurs : prêt principal, PTZ à 0 %, prêt
                employeur. Chacune s'amortit sur ses propres termes, et l'échéancier du dossier
                les additionne mois par mois.
            </p>
        </twig:Notice>

        {% include 'real_estate/loan/forms/_line_form.html.twig' with {
            submit_label: 'Ajouter la ligne',
            cancel_href: path('app_loan_show', {id: loan.id}),
        } %}
    </div>
</div>
{% endblock %}
