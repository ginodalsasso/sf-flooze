{% extends 'layout/app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'real_estate/_styles.html.twig' %}
{% endblock %}

{% block title %}Modifier « {{ line.label }} » — Flooze{% endblock %}

{% block content %}
<twig:PageHeader
    title="Modifier la ligne"
    subtitle="{{ line.label }} · {{ line.loan.bankName }}"
/>

<div class="page-content">
    <div class="form-page">
        <twig:Flash levels="{{ ['error'] }}" />
        {% include 'real_estate/loan/forms/_line_form.html.twig' with {
            submit_label: 'Enregistrer',
            cancel_href: path('app_loan_show', {id: line.loan.id}),
        } %}
    </div>
</div>
{% endblock %}
