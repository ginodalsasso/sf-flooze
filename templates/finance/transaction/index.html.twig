{% extends 'layout/app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'finance/transaction/_styles.html.twig' %}
{% endblock %}

{% block title %}Transactions — Flooze{% endblock %}

{% block content %}
<twig:PageHeader
    title="Transactions"
    subtitle="Historique de tous tes mouvements financiers"
    ctaLabel="Nouvelle transaction"
    ctaHref="{{ path('app_transaction_new') }}"
/>

<div class="page-content">
    <twig:Flash />

    {% include 'finance/transaction/_filters.html.twig' with {route: 'app_transaction_index', routeParams: {}} %}

    {% if transactions|length > 0 %}
        <div class="txn-table-wrap">
            <div class="txn-summary">
                <span class="txn-summary__count">
                    {{ totals.count }} transaction{{ totals.count > 1 ? 's' : '' }}
                </span>
                {% if filter.type is null or filter.type.value != 'transfer' %}
                    <span class="txn-summary__item">
                        Revenus <strong class="txn-amount--income">{{ totals.income|money(space.currency) }}</strong>
                    </span>
                    <span class="txn-summary__item">
                        Dépenses <strong class="txn-amount--expense">{{ totals.expense|money(space.currency) }}</strong>
                    </span>
                    <span class="txn-summary__item">
                        Net
                        <strong class="{{ totals.net starts with '-' ? 'txn-amount--negative' : 'txn-amount--positive' }}">
                            {{ totals.net|money(space.currency) }}
                        </strong>
                    </span>
                    <span class="txn-summary__note">Virements exclus des totaux</span>
                {% endif %}
            </div>

            <table class="txn-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Compte</th>
                        <th>Type</th>
                        <th class="txn-table__amount-header">Montant</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for txn in transactions %}
                        <tr>
                            <td>
                                <span class="txn-date">{{ txn.date|date('d/m/Y') }}</span>
                            </td>
                            <td>
                                <div class="txn-desc">{{ txn.description ?? '—' }}</div>
                                {% set categoryLabel = txn.categoryLabel %}
                                {% if categoryLabel %}
                                    <div class="txn-cat">{{ categoryLabel }}</div>
                                {% endif %}
                                {% if txn.linkedToAsset %}
                                    <div class="txn-cat">
                                        <i data-lucide="lock" class="txn-icon-lock"></i>
                                        Lié à l'actif {{ txn.assetEntry.asset.ticker }}
                                    </div>
                                {% endif %}
                                {% include 'finance/transaction/_tags.html.twig' with {transaction: txn} only %}
                            </td>
                            <td>
                                <span class="txn-account">{{ txn.account.name }}</span>
                                {% if txn.destinationAccount %}
                                    <div class="txn-cat">
                                        → {{ txn.destinationAccount.name }}
                                        {%- if txn.destinationAmount %} ({{ txn.destinationAmount|money(txn.destinationAccount.currency) }}){% endif %}
                                    </div>
                                {% endif %}
                            </td>
                            <td>
                                <twig:Badge
                                    label="{{ txn.type.label() }}"
                                    variant="{{ txn.type.badgeVariant() }}"
                                />
                            </td>
                            <td>
                                <span class="txn-amount txn-amount--{{ txn.type.value }}">
                                    {% if txn.type.value == 'income' %}+{% elseif txn.type.value == 'expense' %}-{% endif %}
                                    {{ txn.amount|money(txn.account.currency) }}
                                </span>
                            </td>
                            <td>
                                {% if txn.linkedToAsset %}
                                    <span class="txn-cat" title="Géré depuis la fiche de l'actif {{ txn.assetEntry.asset.ticker }}">
                                        <i data-lucide="lock" class="txn-icon-lock"></i>
                                        Verrouillé
                                    </span>
                                {% else %}
                                    <div class="txn-actions">
                                        <twig:Button
                                            as="a"
                                            href="{{ path('app_transaction_edit', {id: txn.id}) }}"
                                            icon="pencil"
                                            label="Modifier"
                                            variant="secondary"
                                        />
                                        {% include 'finance/transaction/forms/_delete.html.twig' with {transaction: txn} %}
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% elseif filter.isEmpty %}
        <twig:EmptyState
            icon="arrow-left-right"
            text="Aucune transaction"
            hint="Enregistre ton premier mouvement financier pour commencer le suivi."
            ctaLabel="Nouvelle transaction"
            ctaHref="{{ path('app_transaction_new') }}"
        />
    {% else %}
        <twig:EmptyState
            icon="search-x"
            text="Aucun résultat"
            hint="Aucune transaction ne correspond à cette recherche. Élargis la période ou retire un critère."
            ctaLabel="Réinitialiser les filtres"
            ctaHref="{{ path('app_transaction_index') }}"
        />
    {% endif %}
</div>
{% endblock %}
