{{ form_start(form, {attr: {
    novalidate: 'novalidate',
    'data-controller': 'transfer-guard',
    'data-transfer-guard-source-id-value': form.account.vars.id,
    'data-transfer-guard-dest-id-value': form.destinationAccount.vars.id,
    'data-transfer-guard-type-id-value': form.type.vars.id
}}) }}

    <div class="form-section txn-form-grid">
        <twig:Form:Field field="{{ form.type }}" label="Type de transaction" />
        <twig:Form:Field field="{{ form.date }}" label="Date" />
    </div>

    <div class="form-section txn-form-grid">
        <twig:Form:Field field="{{ form.account }}" label="Compte crypto/actif" />
        <div>
            <twig:Form:Field field="{{ form.amount }}" label="Montant" />
            <p id="asset-available-balance" class="txn-balance-hint"></p>
        </div>
    </div>

    <div class="form-section txn-form-full">
        <twig:Form:Field field="{{ form.description }}" label="Description" />
    </div>

    <div class="form-section txn-form-grid">
        <twig:Form:Field field="{{ form.category }}" label="Catégorie" />
        <twig:Form:Field field="{{ form.tags }}" label="Tags"
                         hint="Projet ou événement — Ctrl/⌘ pour en choisir plusieurs" />
    </div>

    {% include 'finance/transaction/forms/_destination_fields.html.twig' %}

    <div class="form-actions">
        <twig:Button as="a" href="{{ redirect_to ?? path('app_transaction_index') }}" label="Annuler" variant="secondary" />
        <twig:Button type="submit" icon="check" label="{{ submit_label }}" />
    </div>

{{ form_end(form) }}

<script>
(function () {
    const accountSelect = document.getElementById('{{ form.account.vars.id }}');
    const amountInput = document.getElementById('{{ form.amount.vars.id }}');
    const hint = document.getElementById('asset-available-balance');

    function formatMoney(value, currency) {
        const number = parseFloat(value);
        if (isNaN(number)) return '';
        return number.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + currency;
    }

    function updateHint() {
        const option = accountSelect.selectedOptions[0];
        if (!option || !option.dataset.availableBalance) {
            hint.textContent = '';
            return;
        }

        const available = parseFloat(option.dataset.availableBalance);
        const currency = option.dataset.currency || '';
        const amount = parseFloat(amountInput.value.replace(',', '.')) || 0;

        let text = formatMoney(option.dataset.availableBalance, currency) + ' disponible';
        if (amount > available) {
            text += ' — fonds insuffisants';
            hint.classList.add('txn-balance-hint--warning');
        } else {
            hint.classList.remove('txn-balance-hint--warning');
        }
        hint.textContent = text;
    }

    if (accountSelect) {
        accountSelect.addEventListener('change', updateHint);
    }
    if (amountInput) {
        amountInput.addEventListener('input', updateHint);
    }

    updateHint();
})();
</script>
