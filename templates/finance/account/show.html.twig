{% extends 'layout/app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'finance/account/_styles.html.twig' %}
    {% include 'finance/transaction/_styles.html.twig' %}
{% endblock %}

{% block title %}{{ detail.account.name }} — Flooze{% endblock %}

{% block content %}
<twig:PageHeader
    title="{{ detail.account.name }}"
    subtitle="Détail du compte et historique des mouvements"
    ctaLabel="Nouvelle transaction"
    ctaHref="{{ path('app_transaction_new') }}"
/>

<div class="page-content">
    <twig:Flash />

    {# Account summary card #}
    <div class="acc-show-summary">
        <div class="acc-show-meta">
            <div class="acc-card-icon">
                <i data-lucide="{{ detail.account.type.icon() }}"></i>
            </div>
            <div>
                <p class="acc-card-name">{{ detail.account.name }}</p>
                <twig:Badge
                    label="{{ detail.account.type.label() }}"
                    variant="{{ detail.account.type.badgeVariant() }}"
                />
            </div>
        </div>
        <div class="acc-show-balance">
            {% if detail.isAssetAccount %}
                <div class="acc-show-balances">
                    <div class="acc-show-balance-item">
                        <p class="acc-card-balance{% if detail.balance < 0 %} acc-card-balance--negative{% elseif detail.balance > 0 %} acc-card-balance--positive{% endif %}">
                            {{ detail.balance|money(detail.account.currency) }}
                        </p>
                        <p class="acc-card-currency">Solde total</p>
                    </div>
                    <div class="acc-show-balance-item">
                        <p class="acc-card-balance">
                            {{ detail.investedBalance|money(detail.account.currency) }}
                        </p>
                        <p class="acc-card-currency">Investi</p>
                    </div>
                    <div class="acc-show-balance-item">
                        <p class="acc-card-balance{% if detail.availableBalance < 0 %} acc-card-balance--negative{% elseif detail.availableBalance > 0 %} acc-card-balance--positive{% endif %}">
                            {{ detail.availableBalance|money(detail.account.currency) }}
                        </p>
                        <p class="acc-card-currency">Disponible</p>
                    </div>
                </div>
            {% else %}
                {% set balance = detail.balance %}
                <p class="acc-card-balance{% if balance < 0 %} acc-card-balance--negative{% elseif balance > 0 %} acc-card-balance--positive{% endif %}">
                    {{ balance|money(detail.account.currency) }}
                </p>
                <p class="acc-card-currency">Solde actuel</p>
            {% endif %}
        </div>
        <div class="acc-show-actions">
            <twig:Button
                as="a"
                href="{{ path('app_account_edit', {id: detail.account.id}) }}"
                icon="pencil"
                label="Modifier le compte"
                variant="secondary"
            />
        </div>
    </div>

    {# Monthly summary #}
    <div class="acc-show-monthly">
        <div class="acc-show-monthly-item">
            <span class="acc-show-monthly-label">{{ detail.isAssetAccount ? 'Entrées ce mois' : 'Revenus ce mois' }}</span>
            <span class="acc-show-monthly-value acc-show-monthly-value--positive">+{{ detail.monthlyIncome|money(detail.account.currency) }}</span>
        </div>
        <div class="acc-show-monthly-item">
            <span class="acc-show-monthly-label">{{ detail.isAssetAccount ? 'Sorties ce mois' : 'Dépenses ce mois' }}</span>
            <span class="acc-show-monthly-value acc-show-monthly-value--negative">-{{ detail.monthlyExpense|money(detail.account.currency) }}</span>
        </div>
        <div class="acc-show-monthly-item">
            <span class="acc-show-monthly-label">Flux net</span>
            {% set netFlow = detail.monthlyNetFlow %}
            <span class="acc-show-monthly-value {{ netFlow starts with '-' ? 'acc-show-monthly-value--negative' : 'acc-show-monthly-value--positive' }}">
                {{ netFlow|money(detail.account.currency) }}
            </span>
        </div>
    </div>

    {# Transactions list #}
    <h2 class="acc-show-section-title">Mouvements</h2>

    {% include 'finance/transaction/_filters.html.twig' with {
        route: 'app_account_show',
        routeParams: {id: detail.account.id},
    } %}

    {% if detail.hasTransactions %}
        <div class="txn-table-wrap">
            <div class="txn-summary">
                <span class="txn-summary__count">
                    {{ detail.totals.count }} mouvement{{ detail.totals.count > 1 ? 's' : '' }}
                </span>
                {% if filter.type is null or filter.type.value != 'transfer' %}
                    <span class="txn-summary__item">
                        Revenus <strong class="txn-amount--income">{{ detail.totals.income|money(space.currency) }}</strong>
                    </span>
                    <span class="txn-summary__item">
                        Dépenses <strong class="txn-amount--expense">{{ detail.totals.expense|money(space.currency) }}</strong>
                    </span>
                    <span class="txn-summary__item">
                        Net
                        <strong class="{{ detail.totals.net starts with '-' ? 'txn-amount--negative' : 'txn-amount--positive' }}">
                            {{ detail.totals.net|money(space.currency) }}
                        </strong>
                    </span>
                    <span class="txn-summary__note">Sur la sélection · virements exclus des totaux</span>
                {% endif %}
            </div>

            <table class="txn-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Catégorie</th>
                        <th>Type</th>
                        <th class="txn-table__amount-header">Montant</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for txn in detail.transactions %}
                        {# Incoming transfers now appear here: the row is read from this account's point of view. #}
                        {% set isIncoming = txn.incomingFor(detail.account) %}
                        <tr>
                            <td>
                                <span class="txn-date">{{ txn.date|date('d/m/Y') }}</span>
                            </td>
                            <td>
                                <div class="txn-desc">{{ txn.description ?? '—' }}</div>
                                {% if txn.destinationAccount %}
                                    <div class="txn-cat">
                                        {{ isIncoming ? '← ' ~ txn.account.name : '→ ' ~ txn.destinationAccount.name }}
                                    </div>
                                {% endif %}
                                {% include 'finance/transaction/_tags.html.twig' with {transaction: txn} only %}
                            </td>
                            <td>
                                {% set categoryLabel = txn.categoryLabel %}
                                {% if categoryLabel %}
                                    <span class="txn-account">{{ categoryLabel }}</span>
                                {% else %}
                                    <span class="txn-account txn-account--muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if txn.linkedToAsset %}
                                    {% set assetKindLabel = txn.categoryLabel %}
                                    <twig:Badge
                                        label="{{ assetKindLabel }}"
                                        variant="{{ txn.type.badgeVariant() }}"
                                    />
                                {% elseif isIncoming %}
                                    <twig:Badge label="Virement entrant" variant="positive" />
                                {% else %}
                                    <twig:Badge
                                        label="{{ detail.isAssetAccount ? txn.type.assetLabel() : txn.type.label() }}"
                                        variant="{{ txn.type.badgeVariant() }}"
                                    />
                                {% endif %}
                            </td>
                            <td>
                                <span class="txn-amount txn-amount--{{ isIncoming ? 'income' : txn.type.value }}">
                                    {% if txn.type.value == 'income' or isIncoming %}+{% else %}-{% endif %}
                                    {{ txn.amountFor(detail.account)|money(detail.account.currency) }}
                                </span>
                            </td>
                            <td>
                                <div class="txn-actions">
                                    <twig:Button
                                        as="a"
                                        href="{{ path('app_transaction_edit', {id: txn.id, redirect_to: path('app_account_show', {id: detail.account.id})}) }}"
                                        icon="pencil"
                                        label="Modifier"
                                        variant="secondary"
                                    />
                                    {% include 'finance/transaction/forms/_delete.html.twig' with {
                                        transaction: txn,
                                        redirect_to: path('app_account_show', {id: detail.account.id})
                                    } %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% elseif filter.isEmpty %}
        <twig:EmptyState
            icon="arrow-left-right"
            text="Aucun mouvement"
            hint="Ce compte n'a pas encore de transactions enregistrées."
            ctaLabel="Nouvelle transaction"
            ctaHref="{{ path('app_transaction_new') }}"
        />
    {% else %}
        <twig:EmptyState
            icon="search-x"
            text="Aucun résultat"
            hint="Aucun mouvement de ce compte ne correspond à cette recherche."
            ctaLabel="Réinitialiser les filtres"
            ctaHref="{{ path('app_account_show', {id: detail.account.id}) }}"
        />
    {% endif %}
</div>
{% endblock %}
