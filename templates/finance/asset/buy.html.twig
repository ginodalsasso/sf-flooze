{% extends 'layout/app.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'finance/asset/_styles.html.twig' %}
{% endblock %}

{% block title %}Acheter {{ asset.ticker }} — Flooze{% endblock %}

{% block content %}
<twig:PageHeader
    title="Acheter {{ asset.ticker }}"
    subtitle="Renforcer la position sur {{ asset.name }}"
    ctaLabel="Annuler"
    ctaHref="{{ path('app_asset_show', {id: asset.id}) }}"
/>

<div class="page-content">
    <div class="form-page">
        <twig:Flash levels="{{ ['error'] }}" />

        <div class="form-section form-section--lg">
            <p class="form-hint form-hint--lg">
                Quantité détenue : <strong>{{ metrics.totalQuantity|number_format(8, ',', ' ')|replace({',00000000': ''}) }}</strong> unités
                {% if metrics.averagePrice %}
                    · PRU brut : <strong>{{ metrics.averagePrice|number_format(4, ',', ' ') }} {{ asset.currency.value }}</strong>
                {% endif %}
            </p>
            {% include 'finance/asset/_current_price.html.twig' with {priceLabel: 'réellement payé'} %}
        </div>

        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            <div class="form-section acc-form-row">
                <twig:Form:Field field="{{ form.date }}" label="Date d'achat" />
                <twig:Form:Field field="{{ form.quantity }}" label="Quantité achetée" />
            </div>
            <div class="form-section acc-form-row">
                <twig:Form:Field field="{{ form.unitPrice }}" label="Prix unitaire" />
                <twig:Form:Field field="{{ form.fxRate }}" label="Taux de change" />
            </div>

            <div class="form-section form-section--sm">
                <p class="form-hint">
                    <strong>Taux de change</strong> : prix de 1 {{ asset.currency.value }} en euros au moment de l'achat.
                    {% if asset.currency.value == 'EUR' %}
                        Laissez 1,000000 car l'actif est en euros.
                    {% else %}
                        Exemple : si 1 {{ asset.currency.value }} = 0,92 €, saisissez <strong>0,920000</strong>.
                    {% endif %}
                </p>
            </div>

            <div class="form-section acc-form-row">
                <twig:Form:Field field="{{ form.fees }}" label="Frais de transaction" />
                <twig:Form:Field field="{{ form.account }}" label="Compte de détention" />
            </div>
            <div class="form-section acc-form-row">
                <twig:Form:Field field="{{ form.fundingAccount }}" label="Compte de paiement"
                                 hint="Il peut s'agir du compte de détention lui-même : seuls ses fonds non investis seront utilisés." />
                <twig:Form:Field field="{{ form.note }}" label="Note" />
            </div>

            <div class="form-actions">
                <twig:Button as="a" href="{{ path('app_asset_show', {id: asset.id}) }}" label="Annuler" variant="secondary" />
                <twig:Button type="submit" icon="check" label="Enregistrer l'achat" />
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
