{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

    <div class="form-section">
        <twig:Form:Field field="{{ form.name }}" label="Nom de la catégorie" />
    </div>

    <div class="form-section">
        <twig:Form:Field field="{{ form.parent }}" label="Catégorie parente"
                         hint="Laisse vide pour une catégorie racine" createRoute="app_category_new_inline" />
    </div>

    <div class="form-section">
        <twig:Form:Field field="{{ form.applicableTypes }}"
                         label="Types de transaction applicables"
                         hint="La catégorie n'apparaîtra que dans les formulaires de ces types"
                         attr="{{ {class: 'cat-form-types'} }}" />
    </div>

    <div class="form-section">
        <p class="form-section-label">Portée fiscale</p>
        <div class="cat-form-row">
            <twig:Form:Field field="{{ form.fiscalBucket }}" label="Catégorie fiscale" />
            <twig:Form:Field field="{{ form.fiscalRole }}" label="Sens" />
        </div>
        <span class="form-hint">
            Les deux ensemble, ou aucun. Exemples : loyers perçus d'une location nue →
            <em>Revenus fonciers</em> + <em>Revenu</em> ; travaux et taxe foncière du même bien →
            <em>Revenus fonciers</em> + <em>Charge</em>. Un achat perso ne reçoit rien.
        </span>
    </div>

    <div class="form-actions">
        {% if inline|default(false) %}
            <twig:Button type="button" label="Annuler" variant="secondary" data-action="inline-create#close" />
        {% else %}
            <twig:Button as="a" href="{{ path('app_category_index') }}" label="Annuler" variant="secondary" />
        {% endif %}
        <twig:Button type="submit" icon="check" label="{{ submit_label }}" />
    </div>

{{ form_end(form) }}
