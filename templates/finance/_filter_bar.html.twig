{# Quick filters shared by the transaction, account and asset lists.

   route / routeParams  target the list page
   segments             enum cases driving the segmentParam query param
   currentSegment       the active case, or null for "Tout"
   showReset            whether any criterion is currently applied #}
{% import _self as ui %}

{% macro link(href, label, active, class, icon) %}
    <a href="{{ href }}" class="{{ class }}{{ active ? ' ' ~ class ~ '--active' : '' }}">
        {%- if icon %}<i data-lucide="{{ icon }}"></i>{% endif -%}
        {{ label }}
    </a>
{% endmacro %}

{# Every link keeps the criteria already applied: only its own params change. #}
{% set base = routeParams|merge(app.request.query.all) %}
{% set currentFrom = app.request.query.get('date_from') %}
{% set currentTo = app.request.query.get('date_to') %}
{% set periods = [
    {label: 'Ce mois',          from: 'first day of this month'|date('Y-m-d'), to: 'last day of this month'|date('Y-m-d')},
    {label: 'Mois dernier',     from: 'first day of last month'|date('Y-m-d'), to: 'last day of last month'|date('Y-m-d')},
    {label: 'Cette année',      from: 'now'|date('Y-01-01'),                   to: 'now'|date('Y-12-31')},
    {label: '12 derniers mois', from: '-12 months'|date('Y-m-d'),              to: 'now'|date('Y-m-d')},
] %}

<div class="txn-filters__row">
    <div class="txn-segments">
        {{ ui.link(path(route, base|merge({(segmentParam): ''})), 'Tout', currentSegment is null, 'txn-segment', 'list') }}
        {% for segment in segments %}
            {{ ui.link(
                path(route, base|merge({(segmentParam): segment.value})),
                segment.label(),
                currentSegment == segment,
                'txn-segment',
                segment.icon()
            ) }}
        {% endfor %}
    </div>
</div>

<div class="txn-filters__row">
    <span class="txn-filters__legend">Période</span>
    <div class="txn-chips">
        {% for period in periods %}
            {{ ui.link(
                path(route, base|merge({date_from: period.from, date_to: period.to})),
                period.label,
                currentFrom == period.from and currentTo == period.to,
                'txn-chip',
                null
            ) }}
        {% endfor %}
    </div>

    {% if showReset %}
        <a href="{{ path(route, routeParams) }}" class="txn-filters__reset">
            <i data-lucide="x"></i>Réinitialiser
        </a>
    {% endif %}
</div>
