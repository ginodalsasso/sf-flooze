{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

    <div class="form-section">
        <twig:Form:Field field="{{ form.label }}" label="Libellé"
                         hint="Sert de nom à la récurrence et de description à chaque transaction créée" />
        <twig:Form:Field field="{{ form.type }}" label="Type" />
        <twig:Form:Field field="{{ form.account }}" label="Compte" />
        <twig:Form:Field field="{{ form.destinationAccount }}" label="Compte destinataire (virements uniquement)" />
        <twig:Form:Field field="{{ form.amount }}" label="Montant" />
    </div>

    <div class="form-section">
        <twig:Form:Field field="{{ form.frequency }}" label="Fréquence" />
        <twig:Form:Field field="{{ form.intervalCount }}" label="Répéter tous les" />
        <twig:Form:Field field="{{ form.startDate }}" label="Première échéance" />
        <twig:Form:Field field="{{ form.endDate }}" label="Dernière échéance (optionnel)"
                         hint="Vide = la récurrence continue indéfiniment" />
    </div>

    <div class="form-section">
        <twig:Form:Field field="{{ form.category }}" label="Catégorie" />
        <twig:Form:Field field="{{ form.tags }}" label="Tags" />
    </div>

    <div class="form-actions">
        <twig:Button as="a" href="{{ path('app_recurring_index') }}" label="Annuler" variant="secondary" />
        <twig:Button type="submit" icon="check" label="{{ submit_label }}" />
    </div>

{{ form_end(form) }}
